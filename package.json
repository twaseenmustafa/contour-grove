{
  "name": "contour-grove",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.config.* index.html package.json tsconfig.json README.md",
    "format:check": "prettier --check src tests scripts *.config.* index.html package.json tsconfig.json README.md"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6",
    "paper": "0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": ">=5.9 <6.1",
    "typescript-eslint": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
